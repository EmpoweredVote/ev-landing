.DS_Store
node_modules/
# Covers bare `.env` plus every variant, including suffixed ones
# like .env.bak and .env.save that exact-match rules miss.
.env
.env.*
!.env.example
!.env.*.example
*.log
.vscode/
.idea/
take_screenshots.py

# built output of tools/bubble-rig (rebuild with build.cjs; do not commit)
tools/bubble-rig/bubble-rig.html
tools/bubble-rig/bubble-rig.wrapped.html
tools/bubble-rig/rig-*.png

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~

# Playwright MCP page captures. 556 of these were committed to
# ev-accounts and held live credentials.
.playwright-mcp/

# Video pipeline output — frames, audio, MP4s. Never commit: render.yaml
# publishes the whole repo, so a committed episode ships on every deploy.
tools/video/build/

# Raw voice recordings. The takes are the SOURCE the cut reads, not output,
# but they are a quarter of a gigabyte of WAV and render.yaml publishes the
# whole repo — committing them would ship the recordings on every deploy and
# keep them in the history forever. cuts.json names the take each line came
# from; keep the files themselves beside the repo.
audio/
